{
  "status": "SYMBOLIC_IDENTITIES",
  "variables": {
    "lambda1": "x=a+2c",
    "lambda2": "y=a-c",
    "domain": "0<x<1 and 0<y<1",
    "a": "(x+2*y)/3",
    "c": "(x-y)/3"
  },
  "event_probabilities_by_size": {
    "p0_empty": "-(x - 1)*(y - 1)**2",
    "p1_each_singleton": "(y - 1)*(3*x*y - x - 2*y)/3",
    "p2_each_pair": "-y*(3*x*y - 2*x - y)/3",
    "p3_triple": "x*y**2"
  },
  "basis": {
    "Td": "I3",
    "To": "J3-I3",
    "Sd": "diag(1,-1,0)",
    "So": "offdiag entries O_ij=x_i+x_j for x=(1,-1,0), i.e. e13=1,e23=-1,e12=0"
  },
  "derivatives": {
    "Td": {
      "000": {
        "size": "0",
        "p_prime": "-(y - 1)*(2*x + y - 3)",
        "p_double_prime": "-2*(x + 2*y - 3)"
      },
      "001": {
        "size": "1",
        "p_prime": "(6*x*y - 4*x + 3*y**2 - 8*y + 3)/3",
        "p_double_prime": "2*(x + 2*y - 2)"
      },
      "010": {
        "size": "1",
        "p_prime": "(6*x*y - 4*x + 3*y**2 - 8*y + 3)/3",
        "p_double_prime": "2*(x + 2*y - 2)"
      },
      "011": {
        "size": "2",
        "p_prime": "-(6*x*y - 2*x + 3*y**2 - 4*y)/3",
        "p_double_prime": "-2*(x + 2*y - 1)"
      },
      "100": {
        "size": "1",
        "p_prime": "(6*x*y - 4*x + 3*y**2 - 8*y + 3)/3",
        "p_double_prime": "2*(x + 2*y - 2)"
      },
      "101": {
        "size": "2",
        "p_prime": "-(6*x*y - 2*x + 3*y**2 - 4*y)/3",
        "p_double_prime": "-2*(x + 2*y - 1)"
      },
      "110": {
        "size": "2",
        "p_prime": "-(6*x*y - 2*x + 3*y**2 - 4*y)/3",
        "p_double_prime": "-2*(x + 2*y - 1)"
      },
      "111": {
        "size": "3",
        "p_prime": "y*(2*x + y)",
        "p_double_prime": "2*(x + 2*y)"
      }
    },
    "To": {
      "000": {
        "size": "0",
        "p_prime": "2*(x - y)*(y - 1)",
        "p_double_prime": "-2*(x - 4*y + 3)"
      },
      "001": {
        "size": "1",
        "p_prime": "-2*(x - y)*(3*y - 2)/3",
        "p_double_prime": "2*(x - 4*y + 2)"
      },
      "010": {
        "size": "1",
        "p_prime": "-2*(x - y)*(3*y - 2)/3",
        "p_double_prime": "2*(x - 4*y + 2)"
      },
      "011": {
        "size": "2",
        "p_prime": "2*(x - y)*(3*y - 1)/3",
        "p_double_prime": "-2*(x - 4*y + 1)"
      },
      "100": {
        "size": "1",
        "p_prime": "-2*(x - y)*(3*y - 2)/3",
        "p_double_prime": "2*(x - 4*y + 2)"
      },
      "101": {
        "size": "2",
        "p_prime": "2*(x - y)*(3*y - 1)/3",
        "p_double_prime": "-2*(x - 4*y + 1)"
      },
      "110": {
        "size": "2",
        "p_prime": "2*(x - y)*(3*y - 1)/3",
        "p_double_prime": "-2*(x - 4*y + 1)"
      },
      "111": {
        "size": "3",
        "p_prime": "-2*y*(x - y)",
        "p_double_prime": "2*(x - 4*y)"
      }
    },
    "Sd": {
      "000": {
        "size": "0",
        "p_prime": "0",
        "p_double_prime": "2*(x + 2*y - 3)/3"
      },
      "001": {
        "size": "1",
        "p_prime": "-(x + 2*y - 3)/3",
        "p_double_prime": "-2*(x + 2*y - 3)/3"
      },
      "010": {
        "size": "1",
        "p_prime": "(x + 2*y - 3)/3",
        "p_double_prime": "-2*(x + 2*y - 3)/3"
      },
      "011": {
        "size": "2",
        "p_prime": "0",
        "p_double_prime": "2*(x + 2*y - 3)/3"
      },
      "100": {
        "size": "1",
        "p_prime": "0",
        "p_double_prime": "-2*(x + 2*y)/3"
      },
      "101": {
        "size": "2",
        "p_prime": "(x + 2*y)/3",
        "p_double_prime": "2*(x + 2*y)/3"
      },
      "110": {
        "size": "2",
        "p_prime": "-(x + 2*y)/3",
        "p_double_prime": "2*(x + 2*y)/3"
      },
      "111": {
        "size": "3",
        "p_prime": "0",
        "p_double_prime": "-2*(x + 2*y)/3"
      }
    },
    "So": {
      "000": {
        "size": "0",
        "p_prime": "0",
        "p_double_prime": "4*(2*x + y - 3)/3"
      },
      "001": {
        "size": "1",
        "p_prime": "2*(x - y)/3",
        "p_double_prime": "-2*(4*x + 2*y - 3)/3"
      },
      "010": {
        "size": "1",
        "p_prime": "-2*(x - y)/3",
        "p_double_prime": "-2*(4*x + 2*y - 3)/3"
      },
      "011": {
        "size": "2",
        "p_prime": "0",
        "p_double_prime": "4*(2*x + y)/3"
      },
      "100": {
        "size": "1",
        "p_prime": "0",
        "p_double_prime": "-4*(2*x + y - 3)/3"
      },
      "101": {
        "size": "2",
        "p_prime": "-2*(x - y)/3",
        "p_double_prime": "2*(4*x + 2*y - 3)/3"
      },
      "110": {
        "size": "2",
        "p_prime": "2*(x - y)/3",
        "p_double_prime": "2*(4*x + 2*y - 3)/3"
      },
      "111": {
        "size": "3",
        "p_prime": "0",
        "p_double_prime": "-4*(2*x + y)/3"
      }
    }
  },
  "second_derivative_cross_for_intra_blocks": {
    "Td_To": {
      "000": "2*(x - y)",
      "001": "-2*(x - y)",
      "010": "-2*(x - y)",
      "011": "2*(x - y)",
      "100": "-2*(x - y)",
      "101": "2*(x - y)",
      "110": "2*(x - y)",
      "111": "-2*(x - y)"
    },
    "Sd_So": {
      "000": "-4*(x - y)/3",
      "001": "4*(x - y)/3",
      "010": "4*(x - y)/3",
      "011": "-4*(x - y)/3",
      "100": "4*(x - y)/3",
      "101": "-4*(x - y)/3",
      "110": "-4*(x - y)/3",
      "111": "4*(x - y)/3"
    }
  },
  "trivial_standard_hessian_cross_terms": {
    "Td_Sd": "0",
    "Td_So": "0",
    "To_Sd": "0",
    "To_So": "0"
  },
  "block_entry_recipe": "For basis vectors Bi,Bj in {Td,To} or {Sd,So}, B_ij = -sum_S p'_S(Bi)p'_S(Bj)/p_S - sum_S log(p_S) p''_S(Bi,Bj), where p_S is chosen by |S| from p0,p1,p2,p3 and p''_S(Bi,Bj) is the polarized second derivative. The two resulting 2x2 blocks give H'' on the trivial and standard isotypic components."
}
